# Copy this file to .env.local and fill in the values from your Azure AD app
# registration + SharePoint/OneDrive share link. See SETUP.md for the full
# step-by-step walkthrough. Leave any of these blank/unset to run the app on
# its bundled local sample data instead — nothing else changes.

# Azure AD (Entra ID) app registration — "Application (client) ID"
VITE_MSAL_CLIENT_ID=

# Azure AD (Entra ID) app registration — "Directory (tenant) ID"
VITE_MSAL_TENANT_ID=

# The sharing link to the master workbook (QuikitCS_Data.xlsx) on
# SharePoint or OneDrive. Use the link from "Share" > "Copy link" —
# any of the standard SharePoint/OneDrive share link formats work.
VITE_EXCEL_SHARE_URL=

# Optional — only needed if you're hosting this app somewhere other than
# where you registered the Azure AD app's redirect URI. Defaults to
# whatever URL the app is actually running at.
# VITE_MSAL_REDIRECT_URI=
